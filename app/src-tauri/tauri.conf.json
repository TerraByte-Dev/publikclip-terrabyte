{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerraClip",
  "version": "0.1.0",
  "identifier": "dev.terrabyte.terraclip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "node scripts/prepare-resources.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TerraClip",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.terraclip/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources"
    ],
    "publisher": "TerraByte Solutions LLC",
    "shortDescription": "Local-first clipper for long video",
    "longDescription": "Turns long recordings into short vertical clips. Transcription, HUD reading and judgement all run on your own machine through Ollama \u2014 no upload, no account, no training set."
  }
}
